rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // SINGLE SOURCE OF TRUTH: Firebase Auth Custom Claims
    function getRole() {
      return request.auth.token.role;
    }

    function hasRole(roleName) {
      return isAuthenticated() && getRole() == roleName;
    }

    function isSuperAdmin() {
      return hasRole("SuperAdmin");
    }

    function canManageCatalog() {
      return hasRole("SuperAdmin") || hasRole("CatalogManager");
    }

    function canManageOrders() {
      return hasRole("SuperAdmin") || hasRole("OrderManager");
    }

    function canViewFinance() {
      return isSuperAdmin();
    }

    // RBAC AUTHORITY: Determined by 'role' custom claim
    function isAdmin() {
      return getRole() in ["SuperAdmin", "CatalogManager", "OrderManager", "Viewer"];
    }

    function isRider() {
      return hasRole("Rider");
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwner(userId) {
      return isAuthenticated() &&
        request.auth.uid == userId;
    }

    function isRider() {
      return isAuthenticated() && (
        request.auth.token.role == "RIDER" ||
        (
          userDocExists() &&
          get(/databases/$(database)/documents/users/$(request.auth.uid))
            .data.role == "RIDER"
        )
      );
    }

    function isAssignedRider(riderId) {
      return isRider() &&
        riderId == request.auth.uid;
    }


    // ============================================================
    // PRODUCTS
    // Public Read / Admin Write
    // ============================================================

    match /products/{id} {
      allow read: if true;
      allow write: if canManageCatalog();

      // Do NOT automatically expose every future subcollection.
      match /reviews/{reviewId} {
        allow read: if true;

        allow create: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid;

        allow update, delete: if canManageCatalog() ||
          (
            isAuthenticated() &&
            resource.data.userId == request.auth.uid
          );
      }
    }


    // ============================================================
    // PUBLIC CATALOG
    // ============================================================

    match /categories/{id} {
      allow read: if true;
      allow write: if canManageCatalog();
    }

    match /brands/{id} {
      allow read: if true;
      allow write: if canManageCatalog();
    }

    match /crops/{id} {
      allow read: if true;
      allow write: if canManageCatalog();
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if canManageCatalog();
    }


    // ============================================================
    // FINANCIAL / INTERNAL DATA
    // ============================================================

    match /product_costs/{id} {
      allow read, write: if canViewFinance();
    }

    match /ledger/{id} {
      allow read: if canViewFinance();

      // Ledger must only be written by Admin SDK / Cloud Functions.
      allow write: if false;
    }

    match /finance/{document=**} {
      allow read: if canViewFinance();
      allow write: if false;
    }


    // ============================================================
    // ORDERS
    // ============================================================

    match /orders/{orderId} {

      // Customer can read own order.
      // Admin can read all.
      // Rider can read ONLY assigned order.
      allow read: if canManageOrders() ||
        (
          isAuthenticated() &&
          resource.data.userId == request.auth.uid
        ) ||
        (
          isRider() &&
          resource.data.riderId == request.auth.uid
        );

      // Orders are created ONLY by Cloud Functions / Admin SDK.
      allow create: if false;

      // Clients cannot freely modify orders.
      // Assigned rider may update ONLY safe delivery fields. (Correction 13)
      allow update: if canManageOrders() ||
        (
          isRider() &&
          resource.data.riderId == request.auth.uid &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'deliveryStatus',
              'deliveryLocation',
              'deliveryProof',
              'deliveryProofUrl',
              'deliveredAt',
              'riderNote',
              'updatedAt',
              'otpRetryCount',
              'lastOtpAttempt'
            ]) &&
          !request.resource.data.keys().hasAny([
            'totalAmount',
            'userId',
            'paymentStatus',
            'paymentMethod'
          ])
        );

      allow delete: if isSuperAdmin();


      // ----------------------------------------------------------
      // Order Subcollections
      // Explicit rules only.
      // ----------------------------------------------------------

      match /tracking/{trackingId} {
        allow read: if canManageOrders() ||
          (
            isAuthenticated() &&
            get(/databases/$(database)/documents/orders/$(orderId))
              .data.userId == request.auth.uid
          ) ||
          (
            isRider() &&
            get(/databases/$(database)/documents/orders/$(orderId))
              .data.riderId == request.auth.uid
          );

        allow write: if false;
      }
    }


    // ============================================================
    // RETURNS
    // ============================================================

    match /returns/{returnId} {

      allow read: if canManageOrders() ||
        (
          isAuthenticated() &&
          resource.data.userId == request.auth.uid
        ) ||
        (
          isRider() &&
          resource.data.riderId == request.auth.uid
        );


      // Customer can create ONLY their own return request.
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == "REQUESTED" &&
        !("refundAmount" in request.resource.data) &&
        !("refundId" in request.resource.data) &&
        !("approvedBy" in request.resource.data) &&
        !("qcStatus" in request.resource.data) &&
        !("refundStatus" in request.resource.data);


      // Admin has full control.
      // Assigned rider can only update QC/delivery-related fields.
      allow update: if canManageOrders() ||
        (
          isRider() &&
          resource.data.riderId == request.auth.uid &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'riderId',
              'status',
              'qcStatus',
              'qcPhotos',
              'qcNote',
              'qcCompletedAt'
            ])
        );

      allow delete: if isSuperAdmin();
    }


    // ============================================================
    // EXPENSE MANAGEMENT
    // ============================================================

    match /expenses/{id} {
      allow read: if canViewFinance();

      // Strict creation rules
      allow create: if canViewFinance() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.approvalStatus == 'PENDING' &&
        request.resource.data.paymentStatus == 'UNPAID';

      // Protection against unauthorized field tampering
      allow update: if canViewFinance() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['expenseNumber', 'createdBy']);

      allow delete: if isSuperAdmin();
    }

    match /expenseCategories/{id} {
      allow read: if canViewFinance();
      allow write: if canViewFinance();
    }

    match /expenseVendors/{id} {
      allow read: if canViewFinance();
      allow write: if canViewFinance();
    }

    match /expensePayments/{id} {
      allow read: if canViewFinance();
      allow create: if canViewFinance() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false; // Payments are immutable
    }

    match /expenseAuditLogs/{id} {
      allow read: if canViewFinance();
      allow write: if false; // Append-only via server/privileged logic
    }

    match /expenseBudgets/{id} {
      allow read, write: if canViewFinance();
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{uId} {

      allow read: if isOwner(uId) || isAdmin();


      // User can create ONLY their own profile.
      // Sensitive fields cannot be self-created.
      allow create: if isOwner(uId) &&
        !request.resource.data.keys().hasAny([
          'isAdmin',
          'role',
          'walletBalance',
          'rewardPoints',
          'referralCode',
          'customClaims',
          'ledgerPosted'
        ]);


      // User cannot modify security or financial fields.
      // ONLY SuperAdmin can modify another user's role or admin status.
      allow update: if isSuperAdmin() ||
        (
          isOwner(uId) &&
          !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny([
              'isAdmin',
              'role',
              'walletBalance',
              'rewardPoints',
              'referralCode',
              'customClaims',
              'isActive',
              'whitelisted',
              'ledgerPosted'
            ])
        );

      allow delete: if isSuperAdmin();


      // ----------------------------------------------------------
      // ADDRESSES
      // ----------------------------------------------------------

      match /addresses/{addressId} {
        allow read, write: if isOwner(uId) || isAdmin();
      }


      // Explicitly deny unknown user subcollections.
      match /{document=**} {
        allow read, write: if false;
      }
    }


    // ============================================================
    // RIDERS
    // ============================================================

    match /riders/{riderId} {

      allow read: if isAdmin() || isOwner(riderId);

      // Rider records managed by backend/admin only.
      allow write: if isAdmin();
    }


    // ============================================================
    // WISHLIST
    // ============================================================

    match /wishlists/{userId}/{itemId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }


    // ============================================================
    // STOCK NOTIFICATION REQUESTS
    // ============================================================

    match /stock_notification_requests/{id} {

      allow read: if isAdmin();

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin();
    }


    // ============================================================
    // SETTINGS
    // ============================================================

    match /settings/app_config {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/config {
      allow read, write: if isAdmin();
    }


    // ============================================================
    // SOS ALERTS
    // ============================================================

    match /sos_alerts/{alertId} {

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow read: if isAdmin() ||
        (
          isAuthenticated() &&
          resource.data.userId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }


    // ============================================================
    // EMERGENCY ALERTS
    // ============================================================

    match /emergency_alerts/{alertId} {

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow read: if isAdmin() ||
        (
          isAuthenticated() &&
          resource.data.userId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }


    // ============================================================
    // AUDIT LOGS
    // ============================================================

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }


    // ============================================================
    // TRANSACTIONAL OUTBOX
    // ============================================================

    match /outbox/{id} {
      allow read, write: if false; // Cloud Functions only
    }


    // ============================================================
    // WHITELISTED RIDERS
    // ============================================================

    match /whitelisted_riders/{phone} {
      allow read, write: if isAdmin();
    }


    // ============================================================
    // NOTIFICATION LOGS
    // ============================================================

    match /notification_logs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}