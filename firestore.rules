rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== HELPER FUNCTIONS ==========

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      // Robust admin check: Token claim OR Firestore isAdmin flag OR Firestore ADMIN role
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "SuperAdmin"
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ========== CORE CATALOG (Public Read, Admin Write) ==========

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
      // Allow users to update stock during order placement
      allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity']);
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /crops/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========== OPERATIONS & TRANSACTIONS ==========

    match /orders/{orderId} {
      // Users can read own, Admins can read all, Riders can read assigned
      allow read: if isAdmin() ||
                   isOwner(resource.data.userId) ||
                   (isAuthenticated() && resource.data.riderId == request.auth.uid);

      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAdmin() || isOwner(resource.data.userId);
      }
    }

    match /returns/{id} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update: if isAdmin();
    }

    match /users/{uId} {
      allow read: if isOwner(uId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isOwner(uId) || isAdmin();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(uId) || isAdmin();
      }
    }

    // ========== SYSTEM & TRACKING ==========

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /riders/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /sos_alerts/{id} {
      allow read, write: if isAuthenticated();
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    // ========== DEFAULT DENY ==========
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
