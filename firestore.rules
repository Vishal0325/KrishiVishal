rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== HELPER FUNCTIONS ==========

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN"
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ========== CORE COLLECTIONS (Public Read, Admin Write) ==========

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();

      match /variants/{variantId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin();
      }
    }


    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /crops/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========== USER & STAFF COLLECTIONS ==========

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() || isOwner(userId);

      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /cart/{cartItemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /wishlist/{id} {
      allow read, write: if isAuthenticated() && (
        (resource == null || resource.data.userId == request.auth.uid) &&
        (request.resource == null || request.resource.data.userId == request.auth.uid)
      );
    }


    // ========== OPERATIONS ==========

    match /orders/{orderId} {
      // Users can read their own orders. Admins and Riders can read all relevant orders.
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "RIDER"
      );

      // Users can only create their own orders. Only Admins can update status/modify.
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /emergency_alerts/{alertId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin();
    }

    match /cash_deposits/{id} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin() || (resource.data.riderId == request.auth.uid);
    }

    match /rider_shifts/{riderId}/{shiftId} {
      allow read, write: if isOwner(riderId) || isAdmin();
    }

    match /returns/{id} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAdmin();
    }

    // ========== SYSTEM ==========

    match /app_config/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ========== DEFAULT DENY ==========
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
