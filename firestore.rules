/**
 * KRISHIVISHAL - FIRESTORE SECURITY RULES v3.0
 * Updated for Admin Panel full access and Payments Tracking
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========== HELPER FUNCTIONS ==========
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // Allow access if custom claim is set OR if document in users collection has isAdmin: true
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // ========== PUBLIC / CATALOG COLLECTIONS ==========

    match /products/{id} {
      allow read: if true; // Publicly viewable
      allow create, delete: if isAdmin();
      allow update: if isAdmin() &&
        // 44K: Protect ranking/popularity metadata from non-admin updates (e.g. via mobile client)
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'salesCount', 'salesCount90d', 'viewCount', 'searchCount',
          'recommendationCache', 'technicalNameNormalized'
        ]);
    }
    
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /brands/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /crops/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ========== ADMIN / SYSTEM COLLECTIONS ==========

    match /warehouses/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /warehouse_serviceability/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /warehouse_inventory/{id} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can mutate inventory
    }
    
    match /inventory_movements/{id} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can log movements
    }
    
    match /stock_transfers/{id} {
      allow read: if isAdmin();
      allow write: if false; // Handled via Cloud Functions
    }

    match /settings/{id} {
      allow read: if isAuthenticated(); // App needs to read config, but should be authenticated
      allow write: if isAdmin();
    }

    match /riders/{id} {
      allow read: if isAuthenticated(); // App needs to find assigned rider
      allow write: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() || request.auth.uid == 'system';
    }

    match /sos_alerts/{id} {
      allow read, write: if isAuthenticated(); // Riders need to write, Admin needs to read
    }
    
    // ========== ORDERS COLLECTION ==========
    
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin() || (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isOwner(resource.data.userId) || (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow delete: if isAdmin();
      
      match /auditLog/{logId} {
        allow read: if isOwner(resource.data.userId) || isAdmin();
        allow create: if isAdmin();
      }
    }
    
    // ========== RETURNS COLLECTION ==========
    
    match /returns/{returnId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========== USERS COLLECTION ==========
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && !request.resource.data.diff({}).affectedKeys().hasAny(['isAdmin', 'adminRoles']);
      allow update: if (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'adminRoles', 'interestedCategories']))
        || isAdmin();
      allow delete: if isAdmin();

      match /wishlist/{wishId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /stock_notification_requests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /notification_logs/{logId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if false; // Server-only
    }
    
    // ========== NOTIFICATIONS COLLECTION ==========

    match /notifications/{id} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin() || request.auth.uid == 'system';
    }
    
    // ========== HR & WORKFORCE COLLECTIONS ==========
    
    match /employees/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /rider_hr_profiles/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /workforce_documents/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() &&
        // Protect server-controlled fields from client modification
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'ownerId', 'ownerType', 'verificationStatus', 'verifiedBy', 
          'retentionStatus', 'legalHold', 'accessLevel', 'sensitivityLevel'
        ]) || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["SuperAdmin", "HRAdmin"]);
      allow delete: if isAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["SuperAdmin", "HRAdmin"];
    }
    
    match /document_requirements/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["SuperAdmin", "HRAdmin"];
    }
    
    match /physical_files/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /training/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /assets/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /contracts/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["SuperAdmin", "HRAdmin"];
    }
    
    match /background_verification/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["SuperAdmin", "HRAdmin"];
    }
    
    match /document_settings/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["SuperAdmin", "HRAdmin"];
    }
    
    match /statutory_licenses/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["SuperAdmin", "HRAdmin", "DepartmentManager"];
    }
    
    match /leave_requests/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /leave_balances/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /employee_attendance/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /company_holidays/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /employee_salary_structures/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["SuperAdmin", "HRAdmin", "FinanceAdmin"];
    }
    
    match /monthly_payroll_runs/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["SuperAdmin", "HRAdmin", "FinanceAdmin"];
    }
    
    match /system_counters/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin(); // Should be restricted more, but okay for Admin panel transaction
    }

    // Corporate Governance, Cap Table & Debt
    match /corporate_capital/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["SuperAdmin", "FinanceAdmin"];
    }
    match /corporate_shareholders/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["SuperAdmin", "FinanceAdmin"];
    }
    match /corporate_loans/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["SuperAdmin", "FinanceAdmin"];
    }
    match /corporate_interest_ledger/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["SuperAdmin", "FinanceAdmin"];
    }
    match /corporate_funding_rounds/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["SuperAdmin", "FinanceAdmin"];
    }

    // ========== DEFAULT DENY ==========
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
