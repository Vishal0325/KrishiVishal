rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isActiveAccount() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('deactivated', false) != true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') != 'DEACTIVATED';
    }

    function isNotAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return isActiveAccount() && (
        (('admin' in request.auth.token) && request.auth.token.admin == true) ||
        (('isAdmin' in request.auth.token) && request.auth.token.isAdmin == true) ||
        (('role' in request.auth.token) && request.auth.token.role in ["ADMIN", "SuperAdmin", "SUPER_ADMIN", "CatalogManager", "OrderManager", "FinanceAdmin", "Admin"])
      );
    }

    function isSuperAdmin() {
      return isActiveAccount() && (
        (('role' in request.auth.token) && request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN"]) ||
        (('isSuperAdmin' in request.auth.token) && request.auth.token.isSuperAdmin == true)
      );
    }

    function isFinanceRole() {
      return isActiveAccount() && (
        (('role' in request.auth.token) && request.auth.token.role in [
          "SuperAdmin", "SUPER_ADMIN",
          "FinanceAdmin", "FINANCE_ADMIN", "finance_manager", "FinanceManager",
          "CFO", "Accountant", "Auditor"
        ])
      );
    }

    function canViewFinance() {
      return isFinanceRole();
    }

    function isViewer() {
      return isActiveAccount() && ('role' in request.auth.token) && request.auth.token.role == "Viewer";
    }

    function isHubManager() {
      return isActiveAccount() && ('role' in request.auth.token) &&
        request.auth.token.role in ["HubManager", "WarehouseManager"] &&
        ('hubId' in request.auth.token) && request.auth.token.hubId is string &&
        request.auth.token.hubId.size() > 0;
    }

    function isHubManagerFor(data) {
      return isHubManager() && (
        (data.keys().hasAny(['hubId']) && data.hubId == request.auth.token.hubId) ||
        (data.keys().hasAny(['hubCode']) && data.hubCode == request.auth.token.hubId) ||
        (data.keys().hasAny(['warehouseId']) && data.warehouseId == request.auth.token.hubId) ||
        (data.keys().hasAny(['assignedWarehouse']) && data.assignedWarehouse == request.auth.token.hubId) ||
        (data.keys().hasAny(['sourceHubId']) && data.sourceHubId == request.auth.token.hubId) ||
        (data.keys().hasAny(['destinationHubId']) && data.destinationHubId == request.auth.token.hubId) ||
        (data.keys().hasAny(['fromHubId']) && data.fromHubId == request.auth.token.hubId) ||
        (data.keys().hasAny(['toHubId']) && data.toHubId == request.auth.token.hubId)
      );
    }

    function hubManagerUpdateWithinScope() {
      return isHubManagerFor(resource.data) && isHubManagerFor(request.resource.data);
    }

    function isDepartmentManager() {
      return isActiveAccount() && ('role' in request.auth.token) && request.auth.token.role in ["DepartmentManager", "HRAdmin"];
    }

    function isOwner(userId) {
      return isAuthenticated() &&
        request.auth.uid == userId;
    }

    function isRider() {
      return isActiveAccount() && ('role' in request.auth.token) && (
        request.auth.token.role in ["Rider", "rider", "Serviceman", "serviceman", "Partner", "partner", "DELIVERY"]
      );
    }

    function isAuditor() {
      return isActiveAccount() && ('role' in request.auth.token) && request.auth.token.role in ["Auditor", "StockAuditor", "WarehouseAuditor"];
    }

    function isTelecaller() {
      return isActiveAccount() && ('role' in request.auth.token) && request.auth.token.role in ["Telecaller", "KisanCallCenter", "SupportAgent", "CRMExecutive"];
    }



    // ============================================================
    // PRODUCTS
    // Public Read / Admin Write (Metadata only)
    // ============================================================

    match /products/{id} {
      allow read: if true;
      // Price and Stock are derived from SKUs via Cloud Functions
      allow update: if isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['price', 'stockQuantity']);
      allow create: if isAdmin();
      allow delete: if isSuperAdmin();

      match /variants/{variantId} {
        allow read: if true;
        allow write: if false; // Derived from SKUs
      }

      match /reviews/{reviewId} {
        allow read: if true;

        allow create: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid;

        allow update: if isAdmin() ||
          (
            isAuthenticated() &&
            resource.data.userId == request.auth.uid &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId'])
          );

        allow delete: if isAdmin() ||
          (
            isAuthenticated() &&
            resource.data.userId == request.auth.uid
          );
      }
    }


    // ============================================================
    // SKUS & MASTER DATA (ERP SSoT)
    // ============================================================

    match /skus/{skuId} {
      allow read: if isAuthenticated();
      // Only Cloud Functions / Admin SDK can mutate SKU identity, price, and inventory
      allow write: if false;

      match /batches/{batchId} {
        allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data);
        allow write: if false;
      }
    }
    
    match /inventory_movements/{movementId} {
      allow create: if false;
      allow read: if isFinanceRole() || isAdmin() || isHubManagerFor(resource.data);
      allow update: if false; // IMMUTABLE
      allow delete: if false; // IMMUTABLE
    }

    match /master_data/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // ============================================================
    // PUBLIC CATALOG
    // ============================================================

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /crops/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // ============================================================
    // FINANCIAL / INTERNAL DATA
    // ============================================================

    match /product_costs/{id} {
      allow read, write: if canViewFinance();
    }

    match /ledger/{id} {
      allow read: if canViewFinance();
      allow write: if false; // Ledger mutations are server-authoritative
    }

    match /finance/{document=**} {
      allow read: if canViewFinance();
      allow write: if false; // Finance records are mutated through Cloud Functions
    }

    match /accounts/{accountId} {
      allow read: if canViewFinance();
      allow write: if false; // Account balances are mutated through Cloud Functions
    }

    match /expenseCategories/{id} {
      allow read, write: if canViewFinance() || isAdmin() || isSuperAdmin();
    }

    match /expense_categories/{id} {
      allow read, write: if canViewFinance() || isAdmin() || isSuperAdmin();
    }

    match /expenseVendors/{id} {
      allow read, write: if canViewFinance() || isAdmin() || isSuperAdmin();
    }

    match /expense_vendors/{id} {
      allow read, write: if canViewFinance() || isAdmin() || isSuperAdmin();
    }

    // TEMPORARY STRICT CHECK: Explicit role check used instead of isSuperAdmin() helper
    // to prevent staff members with blanket admin:true claims from accessing corporate cap table.
    match /corporate_capital/{id} {
      allow read, write: if isAuthenticated() &&
        ('role' in request.auth.token) && request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN"];
    }

    match /capital_structure/{id} {
      allow read, write: if isAuthenticated() &&
        ('role' in request.auth.token) && request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN"];
    }

    match /corporate_shareholders/{id} {
      allow read, write: if isAuthenticated() &&
        ('role' in request.auth.token) && request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN"];
    }

    match /shareholders/{id} {
      allow read, write: if isAuthenticated() &&
        ('role' in request.auth.token) && request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN"];
    }

    match /corporate_loans/{id} {
      allow read, write: if isAuthenticated() &&
        ('role' in request.auth.token) && request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN"];
    }

    match /corporate_interest_ledger/{id} {
      allow read, write: if isAuthenticated() &&
        ('role' in request.auth.token) && request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN"];
    }

    match /interest_ledger/{id} {
      allow read, write: if isAuthenticated() &&
        ('role' in request.auth.token) && request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN"];
    }

    match /corporate_funding_rounds/{id} {
      allow read, write: if isAuthenticated() &&
        ('role' in request.auth.token) && request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN"];
    }

    match /funding_rounds/{id} {
      allow read, write: if isAuthenticated() &&
        ('role' in request.auth.token) && request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN"];
    }

    match /corporate_simulations/{id} {
      allow read, write: if isAuthenticated() &&
        ('role' in request.auth.token) && request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN"];
    }

    // ============================================================
    // CA & GENERAL LEDGER FINANCIAL COLLECTIONS (SPRINTS 1-10)
    // ============================================================
    match /journal_entries/{entryId} {
      allow read: if isFinanceRole();
      allow write: if false; // Statutory Double-Entry Ledger is immutable and only modifiable via backend engine
      match /lines/{lineId} {
        allow read: if isFinanceRole();
        allow write: if false;
      }
    }

    match /reconciliation_alerts/{alertId} {
      allow read: if isFinanceRole();
      allow write: if false;
    }

    match /reconciliation_logs/{logId} {
      allow read: if isFinanceRole();
      allow write: if false;
    }

    match /fiscal_periods/{periodId} {
      allow read:  if isAuthenticated() && isFinanceRole();
      allow write: if false;
    }

    match /approval_requests/{requestId} {
      allow read: if isFinanceRole();
      allow write: if false;
    }

    match /supplier_invoices/{invoiceId} {
      allow read: if isFinanceRole() || isHubManagerFor(resource.data);
      allow write: if false;
    }

    match /credit_notes/{cnId} {
      allow read: if isFinanceRole();
      allow write: if false;
    }

    match /invoice_counters/{counterId} {
      allow read: if isFinanceRole();
      allow write: if false;
    }

    match /credit_note_counters/{counterId} {
      allow read: if isFinanceRole();
      allow write: if false;
    }

    match /gateway_settlements/{settlementId} {
      allow read: if isFinanceRole();
      allow write: if false;
    }

    match /cash_deposits/{depositId} {
      allow read: if isFinanceRole() || isHubManagerFor(resource.data);
      allow write: if false;
    }

    match /quarantine/{quarantineId} {
      allow read: if isFinanceRole() || isHubManagerFor(resource.data) || isAdmin();
      allow write: if false;
    }

    match /quarantine_items/{itemId} {
      allow read: if isFinanceRole() || isHubManagerFor(resource.data) || isAdmin();
      allow write: if false;
    }

    match /inventory_quarantine/{itemId} {
      allow read: if isFinanceRole() || isHubManagerFor(resource.data) || isAdmin();
      allow write: if false;
    }

    match /journal_vouchers/{id} {
      allow read: if canViewFinance() || isAdmin() || isSuperAdmin();
      allow write: if false; // Journal vouchers are created by validated backend workflows only
    }

    match /expenses/{id} {
      allow read: if canViewFinance();
      allow write: if false; // Validated finance callable is the only expense writer
    }

    match /sales_stats/{statId} {
      allow read: if isAdmin() || isSuperAdmin() || isViewer();
      allow write: if false;
    }


    // ============================================================
    // AI SUPERVISOR
    // ============================================================

    match /ai_activity_logs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ai_action_requests/{id} {
      allow read: if isAdmin();
      allow write: if false; // Approval/rejection must pass backend state validation
    }


    // ============================================================
    // OPERATIONS ESCALATIONS (SLA monitor)
    // ============================================================

    match /escalations/{id} {
      allow read: if isAdmin();

      allow update: if isAdmin() &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['status']);

      allow create, delete: if false;
    }


    // ============================================================
    // ADMIN SYSTEM NOTIFICATIONS
    // ============================================================

    match /notifications/{id} {
      allow read, update: if isAdmin() || isDepartmentManager();
      allow create: if isAdmin();
      allow delete: if isSuperAdmin();
    }


    // ============================================================
    // BROADCAST NOTIFICATIONS
    // ============================================================

    match /broadcast_notifications/{id} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ============================================================
    // NOTIFICATION CAMPAIGNS (ENTERPRISE BROADCAST)
    // ============================================================
    match /notification_campaigns/{id} {
      // Client writes strictly blocked - all mutations managed via v2 Cloud Functions callables
      allow write: if false;
      // Read allowed for Admins, Viewers, Marketing, and Operations/Support staff
      allow read: if isAdmin() || isViewer() || (
        isActiveAccount() && ('role' in request.auth.token) &&
        request.auth.token.role in [
          "SuperAdmin", "SUPER_ADMIN", "Admin", "ADMIN",
          "Marketing", "MarketingManager", "MARKETING_ADMIN",
          "Telecaller", "KisanCallCenter", "SupportAgent",
          "CRMExecutive", "OperationsAdmin"
        ]
      );
    }


    // ============================================================
    // DELIVERY SLOTS
    // ============================================================

    match /delivery_slots/{slotId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }


    // ============================================================
    // ORDERS
    // ============================================================

    match /orders/{orderId} {

      allow read: if isAdmin() || isViewer() || isDepartmentManager() ||
        (
          isHubManagerFor(resource.data)
        ) ||
        (
          isAuthenticated() &&
          resource.data.userId == request.auth.uid
        ) ||
        (
          isRider() &&
          resource.data.riderId == request.auth.uid
        ) ||
        (
          isRider() &&
          (!('riderId' in resource.data) || resource.data.riderId == null || resource.data.riderId == "") &&
          resource.data.status in ['READY_FOR_PICKUP', 'PACKED', 'PLACED', 'CONFIRMED']
        );

      // ALL client order creation MUST go through createOrder Cloud Function. Direct client writes blocked.
      allow create: if isAdmin();

      allow update: if isAdmin() ||
        (
          isRider() &&
          resource.data.riderId == request.auth.uid &&
          resource.data.status in ['ASSIGNED', 'RIDER_ASSIGNED', 'RIDER_ACCEPTED', 'PICKED_UP', 'PICKING_UP', 'IN_TRANSIT', 'OUT_FOR_DELIVERY'] &&
          request.resource.data.status != "DELIVERED" &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
            request.resource.data.status in ['RIDER_ACCEPTED', 'OUT_FOR_DELIVERY', 'DELIVERY_FAILED']
          ) &&
            request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'deliveryStatus',
                'deliveryLocation',
                'riderLocation',
                'deliveryProof',
                'deliveryProofUrl',
                'podPhoto',
                'podPhotoUrl',
                'podSignature',
                'podSignatureUrl',
                'riderNote',
                'updatedAt',
                'syncId',
                'rejectionHistory',
                'ndrReason',
                'ndrNotes',
                'lastAttemptAt',
                'attemptHistory'
              ])
        );
      // Riders CANNOT self-assign orders.
      // Order assignment is exclusively done by:
      // - Hub Manager via Admin Dashboard
      // - Cloud Function automated dispatch
      // Rider can only update status, proof, coordinates, etc. via updateOrderStatus and riderMutations Cloud Functions.

      allow delete: if isSuperAdmin();

      match /tracking/{trackingId} {
        allow read: if isAdmin() ||
          (
            isAuthenticated() &&
            get(/databases/$(database)/documents/orders/$(orderId))
              .data.userId == request.auth.uid
          ) ||
          (
            isRider() &&
            get(/databases/$(database)/documents/orders/$(orderId))
              .data.riderId == request.auth.uid
          );

        allow write: if false;
      }

      // Task 2.1: Secure internal subcollection for OTP and other server-side secrets
      // Only Admin (Cloud Functions / Admin SDK) can read/write delivery OTP secrets
      match /internal/{document=**} {
        allow read: if isAdmin() || isViewer();
        allow write: if isAdmin();
      }
    }


    // ============================================================
    // RETURNS
    // ============================================================

    match /returns/{returnId} {

      allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data) || isDepartmentManager() ||
        (
          isAuthenticated() &&
          resource.data.userId == request.auth.uid
        ) ||
        (
          isRider() &&
          resource.data.riderId == request.auth.uid
        );

      allow create: if false; // All return requests go through requestReturn Cloud Function

      allow update: if isAdmin() ||
        (
          isRider() &&
          resource.data.riderId == request.auth.uid &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'riderId',
              'status',
              'qcStatus',
              'qcPhotos',
              'qcNote',
              'qcCompletedAt',
              'updatedAt'
            ])
        );

      allow delete: if isSuperAdmin();
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{uId} {

      allow read: if isOwner(uId) || isAdmin() || isViewer();

      allow create: if isOwner(uId) &&
        !request.resource.data.keys().hasAny([
          'role',
          'isAdmin',
          'admin',
          'isSuperAdmin',
          'walletBalance',
          'pendingPromoClawback',
          'rewardPoints',
          'referralCode',
          'referredBy',
          'hasCompletedFirstOrder',
          'customClaims'
        ]);

      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'walletBalance', 'pendingPromoClawback', 'status', 'deactivated', 'hubId', 'hubAccess', 'isStaff'
      ]) &&
        (
          isSuperAdmin() ||
          (
            isOwner(uId) &&
            !request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasAny([
                'role',
                'isAdmin',
                'admin',
                'isSuperAdmin',
                'rewardPoints',
                'referredBy',
                'hasCompletedFirstOrder',
                'customClaims'
              ]) &&
            (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['referralCode']) ||
              !('referralCode' in resource.data) || resource.data.referralCode == null || resource.data.referralCode == ''
            )
          )
        );

      allow delete: if isSuperAdmin();

      match /wallet_history/{id} {
        allow read: if isOwner(uId) || canViewFinance() || isAdmin();
        allow write: if false; // Legacy read-only
      }

      match /addresses/{addressId} {
        allow read, write: if isOwner(uId) || isAdmin();
      }

      match /cart/{cartItemId} {
        allow read, write: if isOwner(uId) || isAdmin();
      }

      match /wishlist/{wishlistItemId} {
        allow read, write: if isOwner(uId) || isAdmin();
      }

      // Blocker 7 & H3: allow riders and admin to send delivery/promotional notifications
      match /notifications/{notifId} {
        allow create: if isAdmin() || (
          isRider() &&
          request.resource.data.keys().hasOnly(['orderId', 'type', 'message', 'createdAt']) &&
          request.resource.data.type in ['DELIVERY_STARTED', 'DELIVERY_NEAR', 'DELIVERY_COMPLETED', 'RIDER_ASSIGNED'] &&
          request.resource.data.orderId is string &&
          request.resource.data.orderId.size() > 0 &&
          exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)) &&
          get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.riderId == request.auth.uid
        );
        allow read, update, delete: if isOwner(uId) || isAdmin();
      }

      // FCM Token Registry for multi-device support
      match /fcm_tokens/{tokenId} {
        allow read, write: if isOwner(uId) || isAdmin();
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }


    // ============================================================
    // RIDERS & WHITELIST
    // ============================================================

    match /whitelisted_riders/{id} {
      allow get: if isAdmin() || isViewer() || (
        isAuthenticated() && ('phone_number' in request.auth.token) && (
          request.auth.token.phone_number == id ||
          request.auth.token.phone_number == ('+91' + id) ||
          (resource.data.phone != null && resource.data.phone == request.auth.token.phone_number) ||
          (resource.data.phone != null && ('+91' + resource.data.phone) == request.auth.token.phone_number)
        )
      );
      allow list: if isAdmin() || isViewer() || (
        isAuthenticated() && ('phone_number' in request.auth.token) && (
          resource.data.phone == request.auth.token.phone_number ||
          ('+91' + resource.data.phone) == request.auth.token.phone_number ||
          resource.data.phone == request.auth.token.phone_number.replace('^\\+91', '')
        )
      );
      allow update, create, delete: if isAdmin();
    }

    match /payout_requests/{reqId} {
      allow read: if isAdmin() || isSuperAdmin() || isViewer() || canViewFinance() || isHubManagerFor(resource.data) || (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow write: if false; // Retired legacy collection - Payouts managed via approveRiderPayout & rider_payouts
    }

    match /riders/{riderId} {
      allow read: if isAdmin() || isViewer() || isOwner(riderId) || isHubManagerFor(resource.data);
      // Self-creation blocked: Only Admin can onboard/create rider profiles
      allow create: if isAdmin();
      // Rider self-updates restricted to non-sensitive profile fields
      allow update: if isAdmin() || (
        isOwner(riderId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['kycStatus']) ||
          request.resource.data.kycStatus == 'PENDING_VERIFICATION'
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'address', 'vehicleDetails', 'isAvailable', 'currentLocation', 'location', 'fcmToken', 'updatedAt',
          'currentLat', 'currentLng', 'lastLocationUpdate',
          'online', 'isOnline', 'shiftStartTime', 'shiftEndTime',
          'bankAccount', 'bankName', 'ifscCode', 'vehicleNumber', 'vehicleType',
          'documents', 'kycStatus', 'lastKycSubmissionAt'
        ])
      );
      allow delete: if isAdmin();

      // Attendance subcollection for daily shift logs
      match /attendance/{attendanceId} {
        allow read: if isAdmin() || isViewer() || isOwner(riderId) ||
          (isHubManager() && isHubManagerFor(get(/databases/$(database)/documents/riders/$(riderId)).data));
        allow create, update: if isAdmin() || isOwner(riderId);
        allow delete: if isAdmin();
      }
    }


    // ============================================================
    // HR & COMPLIANCE
    // ============================================================

    match /employees/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /employee_documents/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /physical_files/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /assets/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /exit_requests/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /contracts/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /background_verification/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /training/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /workforce_documents/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /rider_hr_profiles/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /statutory_licenses/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /agri_licenses/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /statutory_registers/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /leaves/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager() || (isAuthenticated() && resource.data.employeeId == request.auth.uid);
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /leave_requests/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /leave_balances/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /employee_attendance/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /employee_salary_structures/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /monthly_payroll_runs/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /monthly_payroll_runs/{runId}/payslips/{payslipId} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /document_requirements/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /document_settings/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /agri_officer_inspections/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /agri_statutory_form_a/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /agri_statutory_form_o/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager();
      allow write: if isAdmin() || isDepartmentManager();
    }

    match /b2b_sales_deals/{id} {
      allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data);
      allow create: if isAdmin() || isHubManagerFor(request.resource.data);
      allow update: if isAdmin() || hubManagerUpdateWithinScope();
      allow delete: if isAdmin() || isHubManagerFor(resource.data);
    }

    match /b2bOffers/{id} {
      allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data);
      allow create: if isAdmin() || isHubManagerFor(request.resource.data);
      allow update: if isAdmin() || hubManagerUpdateWithinScope();
      allow delete: if isAdmin() || isHubManagerFor(resource.data);
    }

    match /coupons/{id} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }

    match /expenseAuditLogs/{id} {
      allow read: if isAdmin() || isViewer() || canViewFinance();
      allow write: if false;
    }

    match /expensePayments/{id} {
      allow read: if isAdmin() || isViewer() || canViewFinance();
      allow write: if false;
    }

    match /farmer_crop_profiles/{id} {
      allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data);
      allow write: if isAdmin() || (isHubManagerFor(resource.data) && hubManagerUpdateWithinScope());
    }

    match /interHubTransfers/{id} {
      allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data);
      allow write: if isAdmin() || (isHubManagerFor(resource.data) && hubManagerUpdateWithinScope());
    }

    match /kisan_call_logs/{id} {
      allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data);
      allow write: if isAdmin() || (isHubManagerFor(resource.data) && hubManagerUpdateWithinScope());
    }

    match /physical_stock_audits/{id} {
      allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data);
      allow write: if isAdmin() || (isHubManagerFor(resource.data) && hubManagerUpdateWithinScope());
    }

    match /rtv_returns/{id} {
      allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data);
      allow write: if isAdmin() || (isHubManagerFor(resource.data) && hubManagerUpdateWithinScope());
    }

    match /supplier_debit_notes/{id} {
      allow read: if isAdmin() || isViewer() || canViewFinance();
      allow write: if false;
    }

    match /supplierDebitNotes/{id} {
      allow read: if isAdmin() || isViewer() || canViewFinance();
      allow write: if false;
    }

    match /trips/{id} {
      allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data);
      allow write: if isAdmin() || (isHubManagerFor(resource.data) && hubManagerUpdateWithinScope());
    }

    match /dispatch_batches/{id} {
      allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data) || isRider();
      allow write: if isAdmin() || (isHubManagerFor(resource.data) && hubManagerUpdateWithinScope());
    }

    match /warehouse_inventory/{id} {
      allow read: if isAdmin() || isViewer() || isDepartmentManager() || isHubManagerFor(resource.data);
      allow create: if isAdmin() || isHubManagerFor(request.resource.data);
      allow update: if isAdmin() || hubManagerUpdateWithinScope();
      allow delete: if isAdmin();
    }


    // ============================================================
    // WISHLIST
    // ============================================================

    match /wishlists/{userId}/{itemId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }


    // ============================================================
    // STOCK NOTIFICATION REQUESTS
    // ============================================================

    match /stock_notification_requests/{id} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }


    // ============================================================
    // SETTINGS & SYSTEM CONFIG
    // ============================================================

    match /settings/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /system_settings/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /config/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /system_summaries/{allPaths=**} {
      allow read: if canViewFinance() || isAdmin() || isSuperAdmin() || isViewer();
      allow write: if false;
    }

    match /stock_transfers/{id} {
      allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data);
      allow write: if isAdmin();
    }

    match /stock_movements/{id} {
      allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data);
      allow write: if isAdmin();
    }

    match /payout_logs/{id} {
      allow read: if isAdmin() || isViewer() || canViewFinance();
      allow write: if false;
    }

    match /rider_performance/{id} {
      allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data);
      allow write: if isAdmin();
    }


    // ============================================================
    // SOS / EMERGENCY ALERTS
    // ============================================================

    match /sos_alerts/{alertId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /emergency_alerts/{alertId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /admin_alerts/{alertId} {
      allow read: if isAdmin() || isSuperAdmin() || isViewer() || isHubManagerFor(resource.data);
      allow write: if isAdmin() || isSuperAdmin();
    }


    // ============================================================
    // AUDIT LOGS
    // ============================================================

    match /audit_logs/{id} {
      allow read: if isSuperAdmin() || isFinanceRole();
      allow write: if false; // Immutable audit log, only Cloud Functions can write
    }

    // ============================================================
    // ADMIN LOGS
    // ============================================================
    match /admin_logs/{id} {
      allow read: if isAdmin() || isSuperAdmin();
      allow write: if false; // Server-authoritative only via Cloud Functions (addSecureAuditLog)
    }


    // ============================================================
    // REFERRALS & WALLET
    // ============================================================

    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.referrerUid ||
        request.auth.uid == resource.data.refereeUid ||
        isAdmin()
      );
      allow write: if false; // Only Cloud Functions mutate this
    }

    match /wallet_transactions/{txnId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.uid ||
        isAdmin() ||
        canViewFinance()
      );
      allow write: if false; // Only Cloud Functions mutate this
    }

    match /rider_transactions/{txId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.riderId ||
        isAdmin() ||
        canViewFinance() ||
        isHubManagerFor(resource.data)
      );
      allow write: if false; // Only Cloud Functions mutate this
    }

    // ============================================================
    // KISAN MITRA / VLE COMMISSION NETWORK
    // ============================================================

    match /vle_profiles/{vleId} {
      allow read: if isAuthenticated() && (request.auth.uid == vleId || isAdmin() || isHubManagerFor(resource.data) || isTelecaller() || isViewer());
      allow create: if isAuthenticated() && request.auth.uid == vleId;
      allow update: if isAuthenticated() && (isAdmin() || (isHubManagerFor(resource.data) && hubManagerUpdateWithinScope()) || (request.auth.uid == vleId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['kycStatus', 'walletBalance', 'totalCommissionEarned', 'totalGmvGenerated'])));
      allow delete: if isAdmin();
    }

    match /vle_commissions/{commId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.vleId || isAdmin() || isHubManagerFor(resource.data) || isViewer());
      allow write: if false; // Server Cloud Functions authoritative only
    }


    // ============================================================
    // SUPPLIERS & PROCUREMENT (Phase 1 & 2)
    // ============================================================

    match /suppliers/{supplierId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }

    match /procurement_queue/{itemId} {
      allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data) || isDepartmentManager();
      allow write: if isAdmin();
    }

    match /purchase_orders/{poId} {
      allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data) || isDepartmentManager();
      allow write: if isAdmin();
      match /{document=**} {
        allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data) || isDepartmentManager();
        allow write: if isAdmin();
      }
    }

    match /goods_receipts/{grnId} {
      allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data) || isDepartmentManager() || canViewFinance();
      allow create: if isAdmin() || isHubManagerFor(request.resource.data);
      allow update: if isAdmin() || (isHubManagerFor(resource.data) && hubManagerUpdateWithinScope());
      allow delete: if isAdmin();
      match /{document=**} {
        allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data) || isDepartmentManager() || canViewFinance();
        allow create: if isAdmin() || isHubManagerFor(request.resource.data);
        allow update: if isAdmin() || (isHubManagerFor(resource.data) && hubManagerUpdateWithinScope());
        allow delete: if isAdmin();
      }
    }

    match /inventory_movements/{movementId} {
      allow read: if isAdmin() || isViewer() || isHubManagerFor(resource.data) || isDepartmentManager();
      allow write: if false; // Immutable ledger: mutated strictly via Cloud Functions / Admin SDK
    }

    match /warehouse_stock/{docId} {
      allow read: if true; // Public catalog stock visibility for spoke resolution
      allow write: if false; // Cloud Functions SSoT for location inventory
    }

    match /pincode_directory/{pincode} {
      allow read: if true; // Public lookup for pincode-to-hub mapping
      allow write: if isAdmin();
    }

    match /warehouses/{warehouseId} {
      allow read: if true;
      allow write: if isAdmin();
      match /{document=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /idempotency_keys/{keyId} {
      allow read, write: if false; // Admin SDK only — no client access
    }

    match /supplier_ledger/{id} {
      allow read: if isAdmin() || canViewFinance() || isViewer();
      allow write: if isAdmin();
    }

    match /customer_ledger/{id} {
      allow read: if isAdmin() || canViewFinance() || isViewer();
      allow write: if isAdmin();
    }

    match /unit_economics/{orderId} {
      allow read: if isAdmin() || canViewFinance() || isViewer();
      allow write: if isAdmin();
    }

    // ============================================================
    // CRM SYSTEM (Support, Complaints, Feedback) - M3
    // ============================================================

    match /support_tickets/{ticketId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin() || isViewer());
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'message', 'updatedAt']));
      allow delete: if isAdmin();
      match /{document=**} {
        allow read, write: if isAuthenticated() &&
          (get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid || isAdmin() || isViewer());
      }
    }

    match /complaints/{complaintId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin() || isViewer());
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'description', 'updatedAt']));
      allow delete: if isAdmin();
      match /{document=**} {
        allow read, write: if isAuthenticated() &&
          (get(/databases/$(database)/documents/complaints/$(complaintId)).data.userId == request.auth.uid || isAdmin() || isViewer());
      }
    }

    match /customer_feedback/{feedbackId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin() || isViewer());
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']));
      allow delete: if isAdmin();
      match /{document=**} {
        allow read, write: if isAuthenticated() &&
          (get(/databases/$(database)/documents/customer_feedback/$(feedbackId)).data.userId == request.auth.uid || isAdmin() || isViewer());
      }
    }


    // ============================================================
    // INTERNAL INFRASTRUCTURE
    // ============================================================

    match /notification_logs/{id} {
      allow read: if isAdmin() || isViewer();
      allow write: if false;
    }

    match /outbox/{id} {
      allow read, write: if false;
    }


    // ============================================================
    // CASH DEPOSITS
    // ============================================================
    
    match /cash_deposits/{id} {
      allow read: if isAdmin() || isSuperAdmin() || isViewer() || isHubManagerFor(resource.data) || canViewFinance() || (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow create: if isRider() &&
        request.resource.data.riderId == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.status in ['PENDING', 'DEPOSITED_AT_WAREHOUSE'] &&
        request.resource.data.keys().hasOnly(['riderId', 'amount', 'status', 'createdAt', 'receiptUrl', 'notes']);
      allow update, delete: if false;
    }

    match /cash_settlements/{settlementId} {
      allow read: if isAdmin() || isSuperAdmin() || isHubManagerFor(resource.data) || (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow write: if false;
    }

    match /hub_bank_deposits/{id} {
      allow read: if isAdmin() || isSuperAdmin() || isViewer() || isHubManagerFor(resource.data) || canViewFinance();
      allow write: if false;
    }

    // ============================================================
    // ABANDONED CARTS
    // ============================================================
    
    match /abandoned_carts/{id} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }

    // ============================================================
    // SERVICE MARKETPLACE
    // ============================================================

    match /service_bookings/{bookingId} {
      // Farmer, Assigned Partner, Admin, or verified partner/serviceman viewing PENDING_ASSIGNMENT can read
      allow read: if isAuthenticated() && (
                    isAdmin()
                    || isViewer()
                    || (('farmerId' in resource.data) && request.auth.uid == resource.data.farmerId)
                    || (('assignedPartnerId' in resource.data) && request.auth.uid == resource.data.assignedPartnerId)
                    || (('status' in resource.data) && resource.data.status == "PENDING_ASSIGNMENT" && ('role' in request.auth.token) && request.auth.token.role in ['Serviceman', 'Partner', 'ADMIN'])
                  );
      // All service booking creations MUST go through createServiceBooking Cloud Function. Client direct write blocked.
      allow create: if false;
      // Client direct update & delete blocked — ALL state mutations MUST go through Cloud Functions
      allow update, delete: if false;
    }

    match /partner_wallets/{partnerId} {
      // Partner can read their own wallet, admin can read all
      allow read: if isAuthenticated() && (request.auth.uid == partnerId || isAdmin() || isViewer());
      // Direct client updates blocked — ONLY Cloud Functions can modify balance
      allow write: if false;
    }

    match /partner_wallet_transactions/{txnId} {
      // Partner can read their transaction history
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.partnerId || isAdmin() || isViewer());
      // Direct client creation blocked — ONLY Cloud Functions can record transactions
      allow write: if false;
    }

    match /services/{serviceId} {
      // Public read for service catalog (Sprayman, Soil Testing, Drone Spray)
      allow read: if true;
      // Only Admin can add or update service definitions
      allow write: if isAdmin();
    }

    // ============================================================
    // RIDER PAYOUTS & COMMISSIONS
    // ============================================================
    match /rider_payouts/{payoutId} {
      allow read: if isAdmin() || isHubManagerFor(resource.data) || (isRider() && request.auth.uid == resource.data.riderId);
      allow write: if false;
    }

    // ============================================================
    // WMS CYCLE COUNTING & BLIND AUDIT SESSIONS
    // ============================================================
    match /audit_sessions/{sessionId} {
      allow read: if isAdmin() || isHubManagerFor(resource.data) || isAuditor();
      allow create: if isAdmin() || isHubManagerFor(request.resource.data);
      allow update: if isAdmin() || hubManagerUpdateWithinScope();
      allow delete: if isAdmin();

      // Blind Audit Security: Auditors CANNOT view live system snapshot
      match /system_snapshot/{docId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /quarantine_stock/{stockId} {
      allow read: if isAdmin() || isHubManagerFor(resource.data) || isAuditor();
      allow create: if isAdmin() || isHubManagerFor(request.resource.data);
      allow update: if isAdmin() || hubManagerUpdateWithinScope();
      allow delete: if isAdmin();
    }

    match /inventory_adjustments/{adjId} {
      allow read: if isAdmin() || isHubManagerFor(resource.data) || isAuditor();
      allow create: if isAdmin() || isHubManagerFor(request.resource.data);
      allow update: if isAdmin() || hubManagerUpdateWithinScope();
      allow delete: if isAdmin();
    }

    match /hub_debit_notes/{noteId} {
      allow read: if isAdmin() || isHubManagerFor(resource.data) || canViewFinance();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    // MARKETING & DIGITAL LEADS (META ADS)
    // ============================================================
    match /leads/{leadId} {
      allow read: if isAdmin() || isSuperAdmin() || isHubManagerFor(resource.data) || isTelecaller();
      allow create: if isAdmin() || isSuperAdmin() || isTelecaller() || isHubManagerFor(request.resource.data);
      allow update: if isAdmin() || isSuperAdmin() || isTelecaller() || hubManagerUpdateWithinScope();
      allow delete: if isAdmin() || isSuperAdmin() || isTelecaller() || isHubManagerFor(resource.data);
    }


    // ============================================================
    // FEATURE FLAGS / KILL SWITCHES (system_configs + audit trail)
    // Writes are server-only (updateFeatureFlag Cloud Function, Admin SDK).
    // 'global' is public pre-login: it must NEVER contain secrets.
    // ============================================================
    match /system_configs/{configId} {
      allow get: if configId == 'global';
      allow get: if isAuthenticated();
      allow list: if isSuperAdmin();
      allow write: if false;
    }

    match /system_config_audit/{auditId} {
      allow read: if isSuperAdmin() ||
        (isHubManager() &&
         ('hubId' in request.auth.token) &&
         ('hubId' in resource.data) &&
         resource.data.hubId == request.auth.token.hubId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    // COMPANY HOLIDAYS & ATOMIC SYSTEM COUNTERS
    // ============================================================
    match /company_holidays/{year} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false; // Server-only atomic counters managed via Admin SDK
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}