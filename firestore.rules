rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isNotAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // FIXED: Role-based only (no legacy tokens)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role in ["ADMIN", "CatalogManager", "OrderManager", "FinanceAdmin", "SuperAdmin", "Admin"] ||
        request.auth.token.isAdmin == true ||
        request.auth.token.admin == true
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN", "ADMIN"] ||
        request.auth.token.isSuperAdmin == true ||
        request.auth.token.isAdmin == true ||
        request.auth.token.admin == true
      );
    }

    function canViewFinance() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        isAdmin() ||
        request.auth.token.role in ["FinanceAdmin", "Accountant", "FinanceManager"]
      );
    }

    function isViewer() {
      return isAuthenticated() && request.auth.token.role == "Viewer";
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isRider() {
      return isAuthenticated() && request.auth.token.role == "Rider";
    }

    function isValidTimestamp(ts) {
      let now = request.time.toMillis();
      return ts >= now - 60000 && ts <= now + 5000;
    }

    function normalizePhone(phone) {
      let p = phone.replace('-', '').replace(' ', '').replace('(', '').replace(')', '');
      return p.size() == 10 ? '+91' + p : (p.size() == 12 && p[0:2] == '91' ? '+' + p : p);
    }

    // ============================================================
    // PRODUCTS
    // ============================================================

    match /products/{id} {
      allow read: if true;
      allow update: if (isAdmin() || isSuperAdmin()) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['price', 'stockQuantity']);
      allow create: if isAdmin() || isSuperAdmin();
      allow delete: if isSuperAdmin();

      match /variants/{variantId} {
        allow read: if true;
        allow write: if false;
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && isNotAnonymous() && request.resource.data.userId == request.auth.uid;
        allow update: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId']));
        allow delete: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      }
    }

    match /skus/{skuId} {
      allow read: if isAuthenticated();
      allow write: if false;
      match /batches/{batchId} {
        allow read, write: if isAdmin() || isSuperAdmin();
      }
    }

    match /master_data/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /brands/{id} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /crops/{id} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    // FINANCIAL DATA
    // ============================================================

    match /product_costs/{id} {
      allow read, write: if canViewFinance() || isAdmin() || isSuperAdmin();
    }

    match /ledger/{id} {
      allow read, write: if canViewFinance() || isAdmin() || isSuperAdmin();
    }

    match /finance/{document=**} {
      allow read, write: if canViewFinance() || isAdmin() || isSuperAdmin();
    }

    match /accounts/{accountId} {
      allow read, write: if canViewFinance() || isAdmin() || isSuperAdmin();
    }

    match /expenses/{id} {
      allow read, write: if canViewFinance() || isAdmin() || isSuperAdmin();
    }

    match /expenseCategories/{id} {
      allow read, write: if canViewFinance() || isAdmin() || isSuperAdmin();
    }

    match /expense_categories/{id} {
      allow read, write: if canViewFinance() || isAdmin() || isSuperAdmin();
    }

    match /expenseVendors/{id} {
      allow read, write: if canViewFinance() || isAdmin() || isSuperAdmin();
    }

    match /expense_vendors/{id} {
      allow read, write: if canViewFinance() || isAdmin() || isSuperAdmin();
    }

    // TEMPORARY STRICT CHECK: Explicit role check used instead of isSuperAdmin() helper
    // to prevent staff members with blanket admin:true claims from accessing corporate cap table.
    match /corporate_capital/{id} {
      allow read, write: if isAuthenticated() &&
        request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN"];
    }

    match /corporate_shareholders/{id} {
      allow read, write: if isAuthenticated() &&
        request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN"];
    }

    match /corporate_loans/{id} {
      allow read, write: if isAuthenticated() &&
        request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN"];
    }

    match /corporate_interest_ledger/{id} {
      allow read, write: if isAuthenticated() &&
        request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN"];
    }

    match /corporate_funding_rounds/{id} {
      allow read, write: if isAuthenticated() &&
        request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN"];
    }

    match /corporate_simulations/{id} {
      allow read, write: if isAuthenticated() &&
        request.auth.token.role in ["SuperAdmin", "SUPER_ADMIN"];
    }

    // TODO: journal_vouchers ka HubManager/WarehouseManager write access
    // temporary hai. Long-term isse Cloud Function (Admin SDK) route karo
    // taaki entry type (STOCK_AUDIT/RTV) validate ho sake, client arbitrary
    // journal entry na bana sake. — added 2026-09-25
    match /journal_vouchers/{id} {
      allow read, write: if canViewFinance() || isAdmin() || isSuperAdmin() ||
        (isAuthenticated() && request.auth.token.role in ["HubManager", "WarehouseManager"]);
    }

    match /system_summaries/{id} {
      allow read, write: if canViewFinance() || isAdmin() || isSuperAdmin();
    }

    match /sales_stats/{statId} {
      allow read, write: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    // AI & OPERATIONS
    // ============================================================

    match /ai_activity_logs/{id} {
      allow read: if isAdmin() || isSuperAdmin();
      allow write: if false;
    }

    match /ai_action_requests/{id} {
      allow read: if isAdmin() || isSuperAdmin();
      allow update: if (isAdmin() || isSuperAdmin()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow create, delete: if false;
    }

    match /escalations/{id} {
      allow read: if isAdmin() || isSuperAdmin();
      allow update: if (isAdmin() || isSuperAdmin()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow create, delete: if false;
    }

    match /notifications/{id} {
      allow read, update: if isAdmin() || isSuperAdmin();
      allow create: if isAdmin() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /broadcast_notifications/{id} {
      allow read: if isAuthenticated() && isNotAnonymous();
      allow create: if isAdmin() || isSuperAdmin();
      allow update, delete: if false;
    }

    match /delivery_slots/{slotId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    // ORDERS
    // ============================================================

    match /orders/{orderId} {
      allow read: if (isAdmin() || isSuperAdmin()) || (isAuthenticated() && resource.data.userId == request.auth.uid) || (isRider() && resource.data.riderId == request.auth.uid);
      allow create: if isAdmin() || isSuperAdmin();

      allow update: if (isAdmin() || isSuperAdmin()) || (isRider() && resource.data.riderId == request.auth.uid && resource.data.status in ['ASSIGNED', 'RIDER_ASSIGNED', 'RIDER_ACCEPTED', 'PICKED_UP', 'PICKING_UP', 'IN_TRANSIT', 'OUT_FOR_DELIVERY'] && request.resource.data.status != "DELIVERED" && isValidTimestamp(request.resource.data.updatedAt) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status in ['RIDER_ACCEPTED', 'OUT_FOR_DELIVERY', 'DELIVERY_FAILED']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveryStatus', 'deliveryLocation', 'riderLocation', 'deliveryProof', 'deliveryProofUrl', 'podPhoto', 'podPhotoUrl', 'podSignature', 'podSignatureUrl', 'riderNote', 'updatedAt', 'syncId', 'rejectionHistory', 'ndrReason', 'ndrNotes', 'lastAttemptAt', 'attemptHistory'])) || (isRider() && (!('riderId' in resource.data) || resource.data.riderId == null || resource.data.riderId == "") && resource.data.status in ['READY_FOR_PICKUP', 'PACKED'] && request.resource.data.status in ["RIDER_ASSIGNED"] && request.resource.data.riderId == request.auth.uid && isValidTimestamp(request.resource.data.updatedAt) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'riderId', 'updatedAt']));

      allow delete: if isSuperAdmin();

      match /tracking/{trackingId} {
        allow read: if (isAdmin() || isSuperAdmin()) || (isAuthenticated() && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid) || (isRider() && get(/databases/$(database)/documents/orders/$(orderId)).data.riderId == request.auth.uid);
        allow write: if false;
      }

      match /internal/{document=**} {
        allow read, write: if isAdmin() || isSuperAdmin();
      }
    }

    // ============================================================
    // RETURNS
    // ============================================================

    match /returns/{returnId} {
      allow read: if (isAdmin() || isSuperAdmin()) || (isAuthenticated() && resource.data.userId == request.auth.uid) || (isRider() && resource.data.riderId == request.auth.uid);
      allow create: if false;
      allow update: if (isAdmin() || isSuperAdmin()) || (isRider() && resource.data.riderId == request.auth.uid && isValidTimestamp(request.resource.data.updatedAt) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['riderId', 'status', 'qcStatus', 'qcPhotos', 'qcNote', 'qcCompletedAt', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{uId} {
      allow read: if isOwner(uId) || (isAdmin() || isSuperAdmin());
      allow create: if isOwner(uId) && isNotAnonymous() && !request.resource.data.keys().hasAny(['isAdmin', 'admin', 'walletBalance', 'rewardPoints', 'referralCode', 'referredBy', 'hasCompletedFirstOrder', 'customClaims']) && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'Rider');
      allow update: if isSuperAdmin() || (isOwner(uId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'admin', 'walletBalance', 'rewardPoints', 'referredBy', 'hasCompletedFirstOrder', 'customClaims']) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['referralCode']) || !('referralCode' in resource.data) || resource.data.referralCode == null || resource.data.referralCode == ''));
      allow delete: if isSuperAdmin();

      match /addresses/{addressId} {
        allow read, write: if isOwner(uId) || (isAdmin() || isSuperAdmin());
      }

      match /cart/{cartItemId} {
        allow read, write: if isOwner(uId) || (isAdmin() || isSuperAdmin());
      }

      match /wishlist/{wishlistItemId} {
        allow read, write: if isOwner(uId) || (isAdmin() || isSuperAdmin());
      }

      match /notifications/{notifId} {
        allow create: if isRider() && isNotAnonymous() && request.resource.data.keys().hasOnly(['orderId', 'type', 'message', 'createdAt']) && request.resource.data.type in ['DELIVERY_STARTED', 'DELIVERY_NEAR', 'DELIVERY_COMPLETED', 'RIDER_ASSIGNED'];
        allow read: if isOwner(uId) || (isAdmin() || isSuperAdmin());
      }

      match /fcm_tokens/{tokenId} {
        allow read, write: if isOwner(uId) || (isAdmin() || isSuperAdmin());
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ============================================================
    // RIDERS & WHITELIST
    // ============================================================

    match /whitelisted_riders/{id} {
      allow get: if (isAdmin() || isSuperAdmin()) || (isAuthenticated() && isNotAnonymous() && (normalizePhone(request.auth.token.phone_number) == normalizePhone(id) || (resource.data.phone != null && normalizePhone(resource.data.phone) == normalizePhone(request.auth.token.phone_number))));
      allow list: if (isAdmin() || isSuperAdmin()) || (isAuthenticated() && isNotAnonymous() && (normalizePhone(resource.data.phone) == normalizePhone(request.auth.token.phone_number)));
      allow update, create, delete: if isAdmin() || isSuperAdmin();
    }

    match /payout_requests/{reqId} {
      allow read: if (isAdmin() || isSuperAdmin()) || (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /riders/{riderId} {
      allow read: if (isAdmin() || isSuperAdmin()) || isOwner(riderId);
      allow create: if isAdmin() || isSuperAdmin();
      allow update: if (isAdmin() || isSuperAdmin()) || (isRider() && isOwner(riderId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['kycStatus']) || request.resource.data.kycStatus == 'PENDING_VERIFICATION') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'address', 'vehicleDetails', 'isAvailable', 'currentLocation', 'location', 'fcmToken', 'updatedAt', 'currentLat', 'currentLng', 'lastLocationUpdate', 'online', 'shiftStartTime', 'shiftEndTime', 'bankAccount', 'bankName', 'ifscCode', 'vehicleNumber', 'vehicleType', 'documents', 'kycStatus', 'lastKycSubmissionAt']));
      allow delete: if isSuperAdmin();
    }

    match /wishlists/{userId}/{itemId} {
      allow read, write: if isOwner(userId) || (isAdmin() || isSuperAdmin());
    }

    match /stock_notification_requests/{id} {
      allow read: if isAdmin() || isSuperAdmin();
      allow create: if isAuthenticated() && isNotAnonymous() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || isSuperAdmin();
    }

    match /settings/{allPaths=**} {
      allow read: if isAdmin() || isSuperAdmin();
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /sos_alerts/{alertId} {
      allow create: if isAuthenticated() && isNotAnonymous();
      allow read: if (isAdmin() || isSuperAdmin()) || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin() || isSuperAdmin();
    }

    match /emergency_alerts/{alertId} {
      allow create: if isAuthenticated() && isNotAnonymous();
      allow read: if (isAdmin() || isSuperAdmin()) || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin() || isSuperAdmin();
    }

    // FIXED: SuperAdmin-only
    match /audit_logs/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.referrerUid || request.auth.uid == resource.data.refereeUid || (isAdmin() || isSuperAdmin()));
      allow write: if false;
    }

    match /wallet_transactions/{txnId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.uid || (isAdmin() || isSuperAdmin()));
      allow write: if false;
    }

    // ============================================================
    // SUPPLIERS & PROCUREMENT
    // ============================================================

    match /suppliers/{supplierId} {
      allow read, write: if isAdmin() || isSuperAdmin();
    }

    match /procurement_queue/{itemId} {
      allow read, write: if isAdmin() || isSuperAdmin();
    }

    match /purchase_orders/{poId} {
      allow read, write: if isAdmin() || isSuperAdmin();
      match /{document=**} {
        allow read, write: if isAdmin() || isSuperAdmin();
      }
    }

    match /goods_receipts/{grnId} {
      allow read, write: if isAdmin() || isSuperAdmin();
      match /{document=**} {
        allow read, write: if isAdmin() || isSuperAdmin();
      }
    }

    match /inventory_movements/{movementId} {
      allow read: if isAdmin() || isSuperAdmin();
      allow write: if false;
    }

    match /warehouse_stock/{docId} {
      allow read: if isAdmin() || isSuperAdmin();
      allow write: if false;
    }

    match /warehouses/{warehouseId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
      match /{document=**} {
        allow read: if true;
        allow write: if isAdmin() || isSuperAdmin();
      }
    }

    match /idempotency_keys/{key} {
      allow read, write: if false;
    }

    match /supplier_ledger/{id} {
      allow read, write: if isAdmin() || isSuperAdmin();
    }

    match /customer_ledger/{id} {
      allow read, write: if isAdmin() || isSuperAdmin();
    }

    match /unit_economics/{orderId} {
      allow read, write: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    // CRM
    // ============================================================

    match /support_tickets/{ticketId} {
      allow create: if isAuthenticated() && isNotAnonymous() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || (isAdmin() || isSuperAdmin()));
      allow update: if (isAdmin() || isSuperAdmin()) || (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'message', 'updatedAt']));
      allow delete: if isAdmin() || isSuperAdmin();
      match /{document=**} {
        allow read, write: if isAuthenticated() && (get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid || (isAdmin() || isSuperAdmin()));
      }
    }

    match /complaints/{complaintId} {
      allow create: if isAuthenticated() && isNotAnonymous() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || (isAdmin() || isSuperAdmin()));
      allow update: if (isAdmin() || isSuperAdmin()) || (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'description', 'updatedAt']));
      allow delete: if isAdmin() || isSuperAdmin();
      match /{document=**} {
        allow read, write: if isAuthenticated() && (get(/databases/$(database)/documents/complaints/$(complaintId)).data.userId == request.auth.uid || (isAdmin() || isSuperAdmin()));
      }
    }

    match /customer_feedback/{feedbackId} {
      allow create: if isAuthenticated() && isNotAnonymous() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || (isAdmin() || isSuperAdmin()));
      allow update: if (isAdmin() || isSuperAdmin()) || (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']));
      allow delete: if isAdmin() || isSuperAdmin();
      match /{document=**} {
        allow read, write: if isAuthenticated() && (get(/databases/$(database)/documents/customer_feedback/$(feedbackId)).data.userId == request.auth.uid || (isAdmin() || isSuperAdmin()));
      }
    }

    match /notification_logs/{id} {
      allow read: if isAdmin() || isSuperAdmin();
      allow write: if false;
    }

    match /outbox/{id} {
      allow read, write: if false;
    }

    match /cash_deposits/{id} {
      allow read: if (isAdmin() || isSuperAdmin()) || (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow create: if (isAdmin() || isSuperAdmin()) || (isRider() && request.resource.data.riderId == request.auth.uid);
      allow update, delete: if isAdmin() || isSuperAdmin();
    }

    match /hub_bank_deposits/{id} {
      allow read, write: if isAdmin() || isSuperAdmin();
    }

    match /abandoned_carts/{id} {
      allow read, write: if isAdmin() || isSuperAdmin();
    }

    match /service_bookings/{bookingId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.farmerId || request.auth.uid == resource.data.assignedPartnerId || (resource.data.status == "PENDING_ASSIGNMENT" && request.auth.token.role in ['Serviceman', 'Partner', 'ADMIN']) || (isAdmin() || isSuperAdmin()));
      allow create: if false;
      allow update, delete: if false;
    }

    match /partner_wallets/{partnerId} {
      allow read: if isAuthenticated() && (request.auth.uid == partnerId || (isAdmin() || isSuperAdmin()));
      allow write: if false;
    }

    match /partner_wallet_transactions/{txnId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.partnerId || (isAdmin() || isSuperAdmin()));
      allow write: if false;
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
