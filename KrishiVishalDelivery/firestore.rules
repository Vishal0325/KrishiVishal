rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== HELPER FUNCTIONS ==========

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["ADMIN", "SuperAdmin"]
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ========== PRODUCTS & CATALOG ==========

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity']);
    }

    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /brands/{id} { allow read: if true; allow write: if isAdmin(); }
    match /crops/{id} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }

    // ========== ORDERS & DELIVERY ==========

    match /orders/{orderId} {
      allow read: if isAdmin() ||
                   isOwner(resource.data.userId) ||
                   (isAuthenticated() && resource.data.riderId == request.auth.uid);

      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Riders can only update specific fields (status, riderLocation, riderId)
      allow update: if isAdmin() || (
        isAuthenticated() &&
        (resource.data.riderId == request.auth.uid || resource.data.riderId == "" || !("riderId" in resource.data)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'riderLocation', 'riderLocationUpdatedAt', 'riderId', 'collectedCash', 'isCashDeposited', 'rejectionHistory'])
      );

      allow delete: if isAdmin();
    }

    // ========== RETURNS & REFUNDS ==========

    match /returns/{returnId} {
      allow read: if isAdmin() ||
                   isOwner(resource.data.userId) ||
                   (isAuthenticated() && resource.data.riderId == request.auth.uid);

      // Customers can create a return request with REQUESTED status
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == "REQUESTED" &&
                    request.resource.data.refundStatus == "PENDING";

      // Strict update rules
      allow update: if isAdmin() || (
        isAuthenticated() && (
          // RIDER UPDATES: Only allowed if assigned to this return
          (resource.data.riderId == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'qcPhotos', 'qcStatus', 'updatedAt']) &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['refundAmount', 'refundStatus', 'gatewayRefundId', 'userId'])) ||

          // CUSTOMER UPDATES: Can only cancel if still requested
          (isOwner(resource.data.userId) &&
           resource.data.status == "REQUESTED" &&
           request.resource.data.status == "CANCELLED" &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        )
      );

      allow delete: if isAdmin();
    }

    // ========== USERS & RIDERS ==========

    match /users/{uId} {
      allow read: if isOwner(uId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isOwner(uId) || isAdmin();
    }

    match /riders/{riderId} {
      allow read: if isAuthenticated();
      // Riders can update their own profile, location, and online status
      allow write, update: if isAdmin() || isOwner(riderId);
    }

    // ========== EMERGENCY & SYSTEM ==========

    match /emergency_alerts/{id} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin() || (isAuthenticated() && resource.data.riderId == request.auth.uid);
    }

    match /sos_alerts/{id} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin() || (isAuthenticated() && resource.data.riderId == request.auth.uid);
    }

    match /app_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payout_logs/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ========== DEFAULT DENY ==========
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
