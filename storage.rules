rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // AUTHENTICATION / RBAC HELPERS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isNotAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // FIXED: Remove legacy token checks
    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.role in [
          "ADMIN",
          "SuperAdmin",
          "CatalogManager",
          "OrderManager",
          "WarehouseManager",
          "HRAdmin",
          "FinanceAdmin"
        ];
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == "SuperAdmin";
    }

    function isRider() {
      return isAuthenticated() &&
        request.auth.token.role == "Rider";
    }

    // ============================================================
    // FILE VALIDATION HELPERS
    // ============================================================

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidImage() {
      return isImage() &&
        request.resource.size < 10 * 1024 * 1024;
    }

    function isValidProfileImage() {
      return isImage() &&
        request.resource.size < 5 * 1024 * 1024;
    }

    function isValidDocument() {
      return (
        request.resource.contentType.matches('application/pdf') ||
        isImage()
      ) &&
      request.resource.size < 15 * 1024 * 1024;
    }

    // ============================================================
    // ORDER HELPERS
    // ============================================================

    function orderExists(orderId) {
      return firestore.exists(
        /databases/(default)/documents/orders/$(orderId)
      );
    }

    function isOrderOwner(orderId) {
      return isAuthenticated() &&
        orderExists(orderId) &&
        firestore.get(
          /databases/(default)/documents/orders/$(orderId)
        ).data.userId == request.auth.uid;
    }

    function isAssignedRider(orderId) {
      return isRider() &&
        orderExists(orderId) &&
        firestore.get(
          /databases/(default)/documents/orders/$(orderId)
        ).data.riderId == request.auth.uid;
    }

    // ============================================================
    // RETURN HELPERS
    // ============================================================

    function returnExists(returnId) {
      return firestore.exists(
        /databases/(default)/documents/returns/$(returnId)
      );
    }

    function isReturnOwner(returnId) {
      return isAuthenticated() &&
        returnExists(returnId) &&
        firestore.get(
          /databases/(default)/documents/returns/$(returnId)
        ).data.userId == request.auth.uid;
    }

    function isReturnRider(returnId) {
      return isRider() &&
        returnExists(returnId) &&
        firestore.get(
          /databases/(default)/documents/returns/$(returnId)
        ).data.riderId == request.auth.uid;
    }

    // ============================================================
    // PUBLIC PRODUCT IMAGES
    // ============================================================

    match /products/{allPaths=**} {
      allow read: if true;

      allow create, update: if (isAdmin() || isSuperAdmin()) &&
        isValidImage();

      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    // PUBLIC BANNERS
    // ============================================================

    match /banners/{allPaths=**} {
      allow read: if true;

      allow create, update: if (isAdmin() || isSuperAdmin()) &&
        isValidImage();

      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    // PUBLIC BRAND LOGOS
    // ============================================================

    match /brands/{allPaths=**} {
      allow read: if true;

      allow create, update: if (isAdmin() || isSuperAdmin()) &&
        isValidImage();

      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    // PUBLIC CATEGORY IMAGES
    // ============================================================

    match /categories/{allPaths=**} {
      allow read: if true;

      allow create, update: if (isAdmin() || isSuperAdmin()) &&
        isValidImage();

      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    // PUBLIC SUBCATEGORY IMAGES
    // ============================================================

    match /subcategories/{allPaths=**} {
      allow read: if true;

      allow create, update: if (isAdmin() || isSuperAdmin()) &&
        isValidImage();

      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    // USER PROFILE FILES
    // ============================================================

    match /users/{userId}/{fileName} {

      allow read: if isAuthenticated() &&
        (
          request.auth.uid == userId ||
          (isAdmin() || isSuperAdmin())
        );

      allow create, update: if isAuthenticated() &&
        request.auth.uid == userId &&
        isValidProfileImage();

      allow delete: if isAuthenticated() &&
        (
          request.auth.uid == userId ||
          (isAdmin() || isSuperAdmin())
        );
    }

    // ============================================================
    // KYC DOCUMENTS
    // ============================================================

    match /kyc/{userId}/{fileName} {

      // FIXED: KYC read restricted to verified KYC only
      allow read: if (isAdmin() || isSuperAdmin()) ||
        (isAuthenticated() && request.auth.uid == userId &&
         firestore.exists(/databases/(default)/documents/riders/$(userId)) &&
         firestore.get(/databases/(default)/documents/riders/$(userId)).data.get('kycStatus', '') == 'VERIFIED');

      allow create, update: if isAuthenticated() &&
        isNotAnonymous() &&
        request.auth.uid == userId &&
        isValidDocument();

      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    // PROOF OF DELIVERY
    // ============================================================

    match /pod/{orderId}/{fileName} {

      allow read: if (isAdmin() || isSuperAdmin()) ||
        isOrderOwner(orderId) ||
        isAssignedRider(orderId);

      allow create: if ((isAdmin() || isSuperAdmin()) || isAssignedRider(orderId)) &&
        isValidImage() &&
        resource == null;

      allow update, delete: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    // LEGACY ORDER FILES
    // ============================================================

    match /orders/{orderId}/{allPaths=**} {

      allow read: if (isAdmin() || isSuperAdmin()) ||
        isOrderOwner(orderId) ||
        isAssignedRider(orderId);

      allow create: if (isAdmin() || isSuperAdmin()) ||
        (
          isAssignedRider(orderId) &&
          isValidImage()
        );

      allow update, delete: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    // RETURN QC PHOTOS
    // ============================================================

    match /returns/{returnId}/{fileName} {

      allow read: if (isAdmin() || isSuperAdmin()) ||
        isReturnOwner(returnId) ||
        isReturnRider(returnId);

      allow create: if ((isAdmin() || isSuperAdmin()) || isReturnRider(returnId)) &&
        isValidImage() &&
        resource == null;

      allow update, delete: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    // EXPENSE ATTACHMENTS
    // ============================================================

    match /expenses/{expenseId}/{fileName} {

      allow read: if isAdmin() || isSuperAdmin();

      allow create: if (isAdmin() || isSuperAdmin()) &&
        isValidDocument();

      allow update, delete: if isAdmin() || isSuperAdmin();
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
