/**
 * KRISHIVISHAL - FIRESTORE SECURITY RULES v3.0
 * Updated for Admin Panel full access and Payments Tracking
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========== HELPER FUNCTIONS ==========
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // Allow access if custom claim is set OR if document in users collection has isAdmin: true
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // ========== PUBLIC / CATALOG COLLECTIONS ==========

    match /products/{id} {
      allow read: if true; // Publicly viewable
      allow create, delete: if isAdmin();
      allow update: if isAdmin() &&
        // 44K: Protect ranking/popularity metadata from non-admin updates (e.g. via mobile client)
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'salesCount', 'salesCount90d', 'viewCount', 'searchCount',
          'recommendationCache', 'technicalNameNormalized'
        ]);
    }
    
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /brands/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /crops/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ========== ADMIN / SYSTEM COLLECTIONS ==========

    match /settings/{id} {
      allow read: if true; // App needs to read config
      allow write: if isAdmin();
    }

    match /riders/{id} {
      allow read: if isAuthenticated(); // App needs to find assigned rider
      allow write: if isAdmin();
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() || request.auth.uid == 'system';
    }

    match /sos_alerts/{id} {
      allow read, write: if isAuthenticated(); // Riders need to write, Admin needs to read
    }
    
    // ========== ORDERS COLLECTION ==========
    
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin() || (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isOwner(resource.data.userId) || (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow delete: if isAdmin();
      
      match /auditLog/{logId} {
        allow read: if isOwner(resource.data.userId) || isAdmin();
        allow create: if isAdmin();
      }
    }
    
    // ========== RETURNS COLLECTION ==========
    
    match /returns/{returnId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ========== USERS COLLECTION ==========
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && !request.resource.data.diff({}).affectedKeys().hasAny(['isAdmin', 'adminRoles']);
      allow update: if (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'adminRoles', 'interestedCategories']))
        || isAdmin();
      allow delete: if isAdmin();

      match /wishlist/{wishId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /stock_notification_requests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /notification_logs/{logId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if false; // Server-only
    }
    
    // ========== NOTIFICATIONS COLLECTION ==========

    match /notifications/{id} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin() || request.auth.uid == 'system';
    }
    
    // ========== DEFAULT DENY ==========
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
